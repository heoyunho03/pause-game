{
  "name": "pause-game",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler pages dev dist",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "python3 ../source/build.py && node scripts/build.mjs",
    "deploy": "wrangler pages deploy dist --project-name=pause-game --branch=main"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0",
    "jose": "^6.0.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0",
    "esbuild": "^0.27.0",
    "@electric-sql/pglite": "^0.3.0"
  }
}
